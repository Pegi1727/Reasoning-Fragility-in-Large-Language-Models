import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

# Load real data
df = pd.read_csv('[/mnt/data/rpe_vs_generation.csv'](https://gapgpt.app/api/v1/code_interpreter/100563522/9ffda0cf-4648-42be-8604-e840b9d22b85/.eJwNy0sOwiAQANC7zMZNMTgOhPYyEz6DJRraAHZjevf69u8H3y6NS4LlobWxT4M4QVz94LG9pcICc87J65gVWXKKMIhyVpMSRzrMCTE4AxPk8hHe_Vj_pe3CR-eXVGl-lK3eYz9ucF4UDyIM:1wwy97:C4xTs8bodfwcSlgh4-yg6A-PYQV1z8m0ihes_KMhwQw/rpe_vs_generation.csv%27))
gens = df['generation'].values

def exponential_decay(g, k, r0):
    return r0 * np.exp(-k * g)

# Fitting for Llama-7B (High Fragility) and Llama-70B (Low Fragility)
popt_7b, _ = curve_fit(exponential_decay, gens, df['llama_7b'])
popt_70b, _ = curve_fit(exponential_decay, gens, df['llama_70b'])

print(f"Empirical Fragility Coefficient (k) - 7B: {popt_7b[0]:.4f}")
print(f"Empirical Fragility Coefficient (k) - 70B: {popt_70b[0]:.4f}")

# Visualization
plt.figure(figsize=(8, 5))
plt.scatter(gens, df['llama_7b'], label='Llama-7B (Actual)', color='red', alpha=0.6)
plt.plot(gens, exponential_decay(gens, *popt_7b), 'r--', label='Fit 7B')
plt.scatter(gens, df['llama_70b'], label='Llama-70B (Actual)', color='blue', alpha=0.6)
plt.plot(gens, exponential_decay(gens, *popt_70b), 'b--', label='Fit 70B')

plt.title("Empirical Reasoning Decay: Scaling Laws in Effect")
plt.xlabel("Recursive Generation (g)")
plt.ylabel("RPE (Fidelity)")
plt.legend()
plt.grid(True, linestyle='--', alpha=0.7)
plt.show()
