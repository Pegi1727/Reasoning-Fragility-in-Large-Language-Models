import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# Load Bayesian HDI results
df_bayesian = pd.read_csv('[/mnt/data/bayesian_hdi_fragility.csv'](https://gapgpt.app/api/v1/code_interpreter/100563522/9ffda0cf-4648-42be-8604-e840b9d22b85/.eJwNy1EOwiAMANC79MefYRCBsF2mKdBK4zLNQJPFeHd9_-8Dr847aoXlYm2I1-DcBKXRwPG48wYLzCKVbBHjo0_Gu8wmResNJ2_zXJ3LKcAEoivjk0b7l0wHd6UNW1WUnW666jjOpb9P8P0BxB0j_A:1wwy97:dpOq7QXYJcRY8Ibp4uZJ0yZqn5ucLE2lXI-0kx5gesg/bayesian_hdi_fragility.csv%27))
df_horizon = pd.read_csv('[/mnt/data/stability_horizon.csv'](https://gapgpt.app/api/v1/code_interpreter/100563522/9ffda0cf-4648-42be-8604-e840b9d22b85/eyJ1c2VyX2lkIjoxMDA1NjM1MjIsImNoYXRfdG9rZW4iOiI5ZmZkYTBjZi00NjQ4LTQyYmUtODYwNC1lODQwYjlkMjJiODUiLCJmaWxlX3BhdGgiOiJzdGFiaWxpdHlfaG9yaXpvbi5jc3YnIn0:1wwy97:TuIlRrAx6DIU1NTqsWxFBslXk9EVPVmXz3G1K_cd6Yk/stability_horizon.csv%27))

def calculate_stability_horizon(k, threshold=0.7):
    # n0 = -ln(tau) / k
    return -np.log(threshold) / k

# Analysis for Model C (Llama-70B)
row_70b = df_bayesian[df_bayesian['model'] == 'Model C (70B)']
k_mean = row_70b['posterior_mean'].values[0]
hdi_low = row_70b['hdi_lower'].values[0]
hdi_high = row_70b['hdi_upper'].values[0]

n0 = calculate_stability_horizon(k_mean)
print(f"Stability Horizon (n0) for 70B: {n0:.2f} generations")

# Simple Uncertainty Visualization
ks = np.linspace(hdi_low - 0.05, hdi_high + 0.05, 100)
# Mocking a posterior PDF based on HDI for visualization
pdf = np.exp(-0.5 * ((ks - k_mean) / ( (hdi_high - hdi_low)/4 ))**2)

plt.fill_between(ks, pdf, color='skyblue', alpha=0.4, label='95% HDI')
plt.axvline(k_mean, color='navy', linestyle='--', label=f'Mean k={k_mean:.3f}')
plt.title("Posterior Distribution of Fragility Coefficient (Llama-70B)")
plt.xlabel("k value")
plt.ylabel("Density")
plt.legend()
plt.show()
